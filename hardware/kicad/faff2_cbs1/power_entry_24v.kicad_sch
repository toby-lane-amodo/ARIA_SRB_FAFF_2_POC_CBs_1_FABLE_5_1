	)
	(text "Vgs = -Vin x R202/(R201+R202) = -7.7 V at 24 V.\nC103 sits gate-to-SOURCE, not gate-to-ground, so Vgs\nstarts at 0 and ramps down over ~3 ms: soft start\nthat never exceeds the +/-20 V Vgs rating."
		(exclude_from_sim no)
		(at 20.32 110.49 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "08fe7074-60eb-5582-b009-044ad0935926")
	)
