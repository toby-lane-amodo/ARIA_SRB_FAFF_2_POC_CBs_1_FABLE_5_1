	(text "REQ-EL-05 / REQ-EL-06: 3.3 V push-pull, 50 ohm source terminated, SMA jack.\nU901 buffers PE5 so the MCU pin never sees the cable and the source impedance\nis repeatable: R907 39 R plus the LVC output impedance (10-15 ohm typical) is\nabout 50 ohm.  TP901 is pre-termination, TP902 post; the SMA itself is the\ncoaxial access of TEST_PLAN 2.3.  D903 is 0.55 pF and does not soften the edge."
		(exclude_from_sim no)
		(at 139.7000 55.8800 0)
		(effects
				(font
					(size 1.27 1.27)
				)
				(justify left top)
			)
		(uuid "241b646a-8c15-5fff-bd20-369062f87649")
	)
