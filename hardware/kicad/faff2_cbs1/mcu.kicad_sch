	(text "24 MHz LVCMOS MEMS oscillator, 10 ppm (USB needs +/-500 ppm).\nSTM32 HSE is an EXTERNAL CLOCK on PH0 only - PH1-OSC_OUT is\nunallocated in the .ioc, so a bare crystal is not possible (REQ-AR-16).\nUSB3320 REFSEL[2:0] = 111 selects a 24 MHz reference (DS Table 5-10).\n33R per branch source-terminates the two-load fan-out. Resolves OQ-03."
		(exclude_from_sim no)
		(at 24.13 125.73 0)
		(effects (font (size 1.27 1.27)) (justify left top))
		(uuid "e2b29cd5-43b7-544d-ab90-4a42ec44931b")
	)
