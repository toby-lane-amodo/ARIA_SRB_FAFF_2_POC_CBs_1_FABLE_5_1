	(label "+1V8_USB"
		(at 375.92 111.76 180)
		(effects (font (size 1.27 1.27)) (justify right bottom))
		(uuid "a587d524-32a0-5299-b75a-d686ea5f92b2")
	)
	(text "The USB3320 needs a real external 1.8 V supply on VDD18 (DS 2.1 pin 28/30\nand DS 5.5.3) as well as 3.3 V on VBAT/VDD33/VDDIO. 1.8 V is generated\nhere rather than requested from power_rails, so no new cross-block rail\nis invented mid-wave; the mcu block therefore owns its test point and\ncurrent break (producer-owns-the-break, DEC-0007 / TEST_PLAN 3).\nVBAT and VDD33 are tied together per USB3320 DS Figure 5-7 (3.3 V supply)."
		(exclude_from_sim no)
		(at 299.72 128.27 0)
		(effects (font (size 1.27 1.27)) (justify left top))
		(uuid "6a163eb8-7d8e-5d23-a942-0217f4cdb192")
	)
	(rectangle (start 22.86 142.24) (end 407.67 194.31)
