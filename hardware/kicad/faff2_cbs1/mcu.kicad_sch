	(text "BOOT0: 10k pull-down fitted = boot from internal flash.\nFit the DNP 1k to boot the system bootloader (DFU)."
		(exclude_from_sim no)
		(at 24.13 62.23 0)
		(effects
			(font
				(size 1.27 1.27)
