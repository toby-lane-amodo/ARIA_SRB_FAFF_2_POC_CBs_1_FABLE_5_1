		(uuid "525af21e-7c8b-593b-81f2-f84f23e77a7a")
	)
	(text "MCU PORTS - PIN ASSIGNMENT IS THE .ioc (DEC-0013); ULPI / QSPI / USB3320_nRESET / SPARE_* stay on this sheet"
