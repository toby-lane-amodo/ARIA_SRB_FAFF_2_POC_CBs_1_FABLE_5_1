		(uuid "b9dcca5c-8ece-56b9-9bab-b8ba50bf01ec")
	)
	(text "EN is tied to each LDO input, so the 5 V rails\nfollow the pre-regulator with no sequencing logic.\n+5VA feeds ADS1235 / ADS1120 AVDD and the AFE\nexcitation chain; +5V feeds the IKP11 read head."
		(exclude_from_sim no)
		(at 215.9 105.41 0)
