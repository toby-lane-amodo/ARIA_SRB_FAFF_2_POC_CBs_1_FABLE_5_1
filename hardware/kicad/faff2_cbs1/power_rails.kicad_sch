	)
	(text "5.5 V, not 5.0 V: it gives both TPS7A20 LDOs\ntheir dropout headroom while staying inside the\nTPS7A20 6.0 V recommended input maximum."
		(exclude_from_sim no)
		(at 20.32 105.41 0)
		(effects
